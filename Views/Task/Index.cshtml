@model List<TaskModel>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Каталог задач</h1>
            <p class="text-muted">Система управления задачами</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            Добавить задачу
        </a>
    </div>

    <div class="row g-4">
        @foreach (var task in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm rounded-4">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary">
                                    ID: @task.Id
                                </span>
                                <span class="badge @(task.IsAvaliable ? "bg-success" : "bg-danger")">
                                    @(task.IsAvaliable ? "Доступна" : "Недоступна")
                                </span>
                            </div>

                            <h5 class="card-title fw-bold mt-2">
                                @task.Name
                            </h5>
                            
                            <p class="text-muted small mb-2">
                                Категория: @task.Category
                            </p>

                            <p class="fs-4 fw-bold text-primary">
                                @task.Price руб.
                            </p>
                        </div>

                        <a asp-action="Details"
                           asp-route-id="@task.Id"
                           class="btn btn-outline-primary mt-3">
                            Подробнее
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>